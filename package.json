{
  "name": "@samsara-dev/appwright",
  "version": "0.11.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.19.6"
  },
  "bin": {
    "appwright": "dist/bin/index.js"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest --config ./src/tests/vitest.config.mts",
    "build": "tsc --build",
    "changeset": "changeset",
    "clean": "tsc --build --clean",
    "release": "changeset publish",
    "build:doc": "typedoc --out api-references src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bheemreddy-samsara/appwright.git"
  },
  "keywords": [
    "e2e",
    "automation",
    "ios",
    "android",
    "testing"
  ],
  "author": "bheem.reddy@samsara.com",
  "license": "Apache-2.0",
  "description": "E2E mobile app testing done right, with the Playwright test runner",
  "dependencies": {
    "@aws-sdk/client-device-farm": "^3.635.0",
    "@aws-sdk/client-s3": "^3.958.0",
    "@aws-sdk/client-sts": "^3.635.0",
    "@empiricalrun/llm": "^0.25.1",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@playwright/test": "^1.58.2",
    "appium": "^3.1.2",
    "appium-uiautomator2-driver": "^5.0.7",
    "appium-xcuitest-driver": "^10.2.2",
    "async-retry": "^1.3.3",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "4.0.5",
    "gpt-driver-node": "^1.0.11",
    "node-fetch": "^3.3.2",
    "picocolors": "^1.1.0",
    "webdriver": "^8.36.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@empiricalrun/eslint-config": "^0.5.0",
    "@empiricalrun/typescript-config": "^0.3.0",
    "@eslint/js": "^9.39.0",
    "@types/async-retry": "^1.4.9",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.5.2",
    "eslint": "9.39.2",
    "typedoc": "0.28.15",
    "vitest": "^4.0.16"
  }
}
